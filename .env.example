# === Required ===
OPENAI_API_KEY=            # API key (OpenAI, or any OpenAI-compatible provider)
# OPENAI_BASE_URL=         # Custom endpoint. Uncomment to override api.openai.com
                           # Gemini: https://generativelanguage.googleapis.com/v1beta/openai/

# === Optional: multi-model benchmark (for model_profiles in config.yaml) ===
GEMINI_API_KEY=            # Gemini API key (when running multiple providers simultaneously)

# === Judge ===
JUDGE_MODEL=gpt-4o         # Model for judge evaluation (default: gpt-4o)
